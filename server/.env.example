PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tsai
# 前後端分開啟動時的前端網址；單容器部署可設為正式網址或留空
CLIENT_ORIGIN=http://localhost:5173
# 對外分享與 Email 使用的正式網址；Zeabur 可填 ${ZEABUR_WEB_URL}
PUBLIC_APP_URL=
# 預設透過容器內部 localhost 產生 PDF，通常不需設定
PDF_RENDER_BASE_URL=
# 正式環境或多台伺服器部署時，請設定長隨機值
PDF_RENDER_SECRET=

# Gmail 寄送：只需填寫這兩項（PASSWORD 必須是 Google 應用程式密碼）
SMTP_EMAIL=
SMTP_PASSWORD=

# Gmail 預設值，通常不需修改
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_FROM_NAME=寵物健康管理系統
# 留空時使用 SMTP_EMAIL
MAIL_FROM=
# 選填：飼主回覆郵件時的收件地址
MAIL_REPLY_TO=
