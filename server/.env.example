PORT=3000
# 跨文件一致性操作使用 MongoDB transaction，因此本機也需以 replica set 模式啟動。
# MongoDB Atlas 已預設支援；本機啟動 mongod --replSet rs0 並執行 rs.initiate() 後可使用：
MONGODB_URI=mongodb://127.0.0.1:27017/tsai?replicaSet=rs0
# 前後端分開啟動時的前端網址；單容器部署可設為正式網址或留空
CLIENT_ORIGIN=http://localhost:5173
# 對外分享與 Email 使用的正式網址；Zeabur 可填 ${ZEABUR_WEB_URL}
# NODE_ENV=production 時必填，沒有就不給啟動（未設定時會退而從請求的 Host 推斷，
# 等於讓呼叫端決定寄給飼主的信裡出現哪個網域）。開發環境留空即可。
PUBLIC_APP_URL=
# 產生 PDF 時 Puppeteer 要連的前端網址。正式環境預設連容器內部 localhost，
# 開發時（Express 不提供前端靜態檔）自動改用 CLIENT_ORIGIN，兩種情況通常都不需設定
PDF_RENDER_BASE_URL=
# 正式環境或多台伺服器部署時，請設定長隨機值
PDF_RENDER_SECRET=
# 分享連結預設有效天數（1–365）
SHARE_LINK_DAYS=30

# Cloudinary：表單圖片欄位採前端直傳，簽名只由後端產生。
# UPLOAD_PRESET 要先在 Cloudinary 建好同名的 signed preset（見 docs/ZEABUR_DEPLOY.md），沒設定就不簽發上傳。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_UPLOAD_PRESET=
# 測試機與正式機共用 Cloudinary 帳號時用不同資料夾分流
CLOUDINARY_IMAGE_FOLDER=tsai-medical-records

# 登入啟用後，首次啟動會以這組資料建立共用診所帳號；帳號建立後這兩個
# 環境變數不會再被讀取。之後要改密碼請用 `npm run auth:set-password -- <帳號> <新密碼>`，
# 或用 `npm run auth:revoke-sessions -- <帳號>` 讓目前所有登入 session 立即失效
# （改密碼時也會自動一併失效，不用另外執行）。
AUTH_ENABLED=true
# 至少 32 字元的隨機字串
JWT_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# IDEXX 檢驗結果：診所電腦上的抓檔程式上傳時要帶的密鑰，至少 32 字元的隨機字串，
# 抓檔程式那邊設同一個值。留空＝不接收（POST /api/lab-results/import 回 503）。
IDEXX_BRIDGE_TOKEN=
# 「送 IDEXX」：off（預設，按鈕不出現）／census／work_request；要到診所跟 IDEXX 確認後才打開（見 docs/IDEXX_INTERLINK.md）
IDEXX_CENSUS_MODE=
# 送到 IDEXX 主機的檔案編碼：big5（預設）／utf-8
IDEXX_CENSUS_ENCODING=

# Gmail 寄送：只需填寫這兩項（PASSWORD 必須是 Google 應用程式密碼）
SMTP_EMAIL=
SMTP_PASSWORD=

# Gmail 預設值，通常不需修改
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_FROM_NAME=謙華動物醫院
# 留空時使用 SMTP_EMAIL
MAIL_FROM=
# 選填：飼主回覆郵件時的收件地址
MAIL_REPLY_TO=

# 退信檢查：用上面的 Gmail 帳號走 IMAP 讀寄件信箱裡的退信通知，把投不到的寄送改成失敗。設 off 關掉。
MAIL_BOUNCE_CHECK=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
